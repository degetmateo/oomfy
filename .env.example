# ==============================================
# Oomfy Environment Configuration Template
# ==============================================

# Entorno y Red
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seguridad y Criptografía (obligatorias y distintas en producción)
JWT_SECRET=change_me_dev_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_min_32_chars

# Base de Datos PostgreSQL
POSTGRES_URL=localhost
POSTGRES_PORT=5432
POSTGRES_DB_NAME=oomfy
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
PG_DATABASE_URI=postgresql://postgres:postgres@localhost:5432/oomfy
PG_DATABASE_CA=

# Base de Datos MongoDB
MONGODB_DATABASE_KEY=mongodb://localhost:27017
MONGODB_DATABASE_NAME=oomfy

# Correo Transaccional (Resend)
RESEND_KEY=re_your_resend_api_key

# Hosting de Imágenes (ImgBB)
IMGBB_KEY=your_imgbb_api_key

# GIFs (Klipy)
KLIPY_KEY=your_klipy_api_key

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@oomfy.online
