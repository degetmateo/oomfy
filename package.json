{
  "name": "oomfy-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Oomfy Social Network - Modern Monorepo",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@oomfy/*\" dev",
    "dev:api": "pnpm --filter @oomfy/api dev",
    "dev:web": "pnpm --filter @oomfy/web dev",
    "build": "pnpm --recursive --filter \"@oomfy/*\" build",
    "build:api": "pnpm --filter @oomfy/shared build && pnpm --filter @oomfy/api build",
    "start:api": "pnpm --filter @oomfy/api start",
    "build:web": "pnpm --filter @oomfy/shared build && pnpm --filter @oomfy/web build",
    "start:web": "pnpm --filter @oomfy/web start",
    "preview:web": "pnpm --filter @oomfy/web preview",
    "test": "pnpm --recursive run test",
    "test:coverage": "pnpm --recursive run test:coverage",
    "lint": "pnpm --recursive run lint",
    "db:migrate": "pnpm --filter @oomfy/api db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
